# Clé API Google Gemini (extraction des relevés)
GEMINI_API_KEY=

# Connexion propriétaire PostgreSQL : utilisée uniquement pour les migrations au démarrage
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/gares_db

# Rôle applicatif soumis au Row Level Security (créé automatiquement au démarrage)
APP_DB_USER=bankorama_app
APP_DB_PASSWORD=

# Secret de signature JWT : 32 caractères minimum
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# SMTP (465 = SSL, 587 = STARTTLS)
SMTP_HOST=
SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# URL du frontend (liens dans les emails)
FRONTEND_URL=http://localhost:3000

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,https://bankorama-frontend-app.vercel.app

# Swagger /docs : false en production
ENABLE_DOCS=true
